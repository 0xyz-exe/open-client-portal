# Open Client Portal Environment Configuration

APP_ENV=production
APP_NAME="Open Client Portal"

# Database Configuration (PostgreSQL for Docker, SQLite for local dev)
# Local SQLite default: sqlite:///./open_client_portal.db
DATABASE_URL=postgresql://ocp_user:ocp_secure_password_2026@postgres:5432/open_client_portal

# Security & Session Authentication
SECRET_KEY=change-this-to-a-random-64-character-secret-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=uploads

# Networking
CORS_ORIGINS="*"
